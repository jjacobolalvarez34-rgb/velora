<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Abrir el diálogo de desinstalar del sistema (SEGURIDAD §2). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Contactos en el buscador: opt-in, se pide tras un aviso (ADR-025). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Tiempo de uso de hoy: acceso especial que el usuario concede en Ajustes (ADR-024). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Visibilidad de paquetes: solo apps abribles. Nunca QUERY_ALL_PACKAGES (SEGURIDAD §2). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".VeloraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Velora"
        tools:targetApi="36">

        <!-- Permite medir el release con Macrobenchmark; solo desde el shell (adb). -->
        <profileable android:shell="true" />

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Velora.Home"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Tocar el ícono de Velora abre el inicio (ADR-014). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notificaciones y música en el inicio: opt-in, solo el sistema puede enlazarlo (SEGURIDAD §3.2). -->
        <service
            android:name=".services.VeloraNotificationListener"
            android:exported="false"
            android:label="@string/notifications_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Doble toque para bloquear: opt-in, lo único que hace (ADR-009, SEGURIDAD §3.3). -->
        <service
            android:name=".services.LockAccessibilityService"
            android:exported="false"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>

        <!-- Interna: se abre manteniendo presionado el inicio (ADR-014). -->
        <activity
            android:name=".feature.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_launcher_label" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 y anteriores. Mismas reglas que data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="file" path="icons/" />
        <exclude domain="file" path="backgrounds/" />
    <exclude domain="database" path="apps_cache.db" />
    <!-- PIN de las ocultas (hash): nunca sale del teléfono (ADR-034). -->
    <exclude domain="file" path="datastore/velora_lock.preferences_pb" />
</full-backup-content>
